#!/usr/bin/env python3
"""Show progress of open Refract plans from docs/plans/*/.handover.md.

Usage:
  refract-stats [DIR]       multi-line summary for DIR (default: cwd)
  refract-stats --statusline  one line; reads Claude Code statusline JSON on stdin
  refract-stats --hook        hook JSON {"systemMessage": ...}; reads hook JSON on stdin
"""

import json
import pathlib
import re
import sys

HIDDEN_STATUSES = {"DONE"}
NEXT_WIDTH = 40


def find_plans_dir(start):
    for directory in [start, *start.parents]:
        plans = directory / "docs" / "plans"
        if plans.is_dir():
            return plans
    return None


def unquote(value):
    value = value.strip()
    if len(value) >= 2 and value[0] == value[-1] and value[0] in "\"'":
        return value[1:-1]
    return value


def parse_front_matter(text):
    lines = text.splitlines()
    if not lines or lines[0].strip() != "---":
        return None
    scalars, lists, key = {}, {}, None
    for line in lines[1:]:
        if line.strip() == "---":
            return scalars, lists
        top = re.match(r"^(\w+):\s*(.*)$", line)
        if top:
            key, value = top.groups()
            scalars[key] = unquote(value)
            lists[key] = re.findall(r"\{[^}]*\}", value) if value.startswith("[") else []
        elif key and line.lstrip().startswith("- "):
            lists[key].append(line.lstrip()[2:])
    return None


def item_field(item, name):
    match = re.search(rf'\b{name}:\s*("(?:[^"\\]|\\.)*"|[^,}}]+)', item)
    return unquote(match.group(1)) if match else None


def plan_stats(handover):
    parsed = parse_front_matter(handover.read_text(encoding="utf-8"))
    if parsed is None:
        return None
    scalars, lists = parsed
    status = scalars.get("status", "?")
    if status in HIDDEN_STATUSES:
        return None
    plan = handover.parent / "PLAN.md"
    total = None
    if plan.is_file():
        total = len(re.findall(r"^#{2,3} Phase \d+", plan.read_text(encoding="utf-8"), re.M)) or None
    checklist = lists.get("checklist", [])
    states = [item_field(item, "status") for item in checklist]
    doing = next((item_field(i, "step") for i, s in zip(checklist, states) if s == "doing"), None)
    return {
        "slug": handover.parent.name,
        "status": status,
        "phase": scalars.get("current_phase", "?"),
        "total": total,
        "done": states.count("done"),
        "steps": len(checklist),
        "blocked": states.count("blocked"),
        "doing": doing,
        "debt": len(lists.get("debt", [])),
        "next": scalars.get("next_action", ""),
    }


def collect(start):
    plans = find_plans_dir(start)
    if plans is None:
        return []
    stats = (plan_stats(path) for path in sorted(plans.glob("*/.handover.md")))
    return [s for s in stats if s]


def phase_text(s):
    return f"{s['phase']}/{s['total']}" if s["total"] else str(s["phase"])


def shorten(text, width):
    return text if len(text) <= width else text[: width - 3] + "..."


def statusline(stats):
    parts = []
    for s in stats:
        part = f"{s['slug']} {s['status']} P{phase_text(s)}"
        if s["steps"]:
            part += f" {s['done']}/{s['steps']}"
            if s["doing"]:
                part += f" [{shorten(s['doing'], 24)}]"
        part += f" debt {s['debt']}"
        if s["next"]:
            part += f" > {shorten(s['next'], NEXT_WIDTH)}"
        parts.append(part)
    return " ; ".join(parts)


def summary(stats):
    lines = ["Refract plans"]
    for s in stats:
        line = f"{s['slug']}: {s['status']}, phase {phase_text(s)}"
        if s["steps"]:
            line += f", checklist {s['done']}/{s['steps']} done"
            if s["blocked"]:
                line += f", {s['blocked']} blocked"
        line += f", debt {s['debt']}"
        lines.append(line)
        if s["doing"]:
            lines.append(f"  doing: {s['doing']}")
        if s["next"]:
            lines.append(f"  next: {s['next']}")
    return "\n".join(lines)


def read_stdin_json():
    try:
        return json.load(sys.stdin)
    except ValueError:
        return {}


def main(argv):
    mode = argv[1] if len(argv) > 1 else ""
    if mode == "--statusline":
        payload = read_stdin_json()
        cwd = (payload.get("workspace") or {}).get("current_dir") or payload.get("cwd") or "."
        stats = collect(pathlib.Path(cwd).resolve())
        if stats:
            print(statusline(stats), end="")
        return 0
    if mode == "--hook":
        payload = read_stdin_json()
        if payload.get("stop_hook_active"):
            return 0
        if payload.get("hook_event_name") == "PostToolUse":
            path = (payload.get("tool_input") or {}).get("file_path", "")
            if not path.endswith(".handover.md"):
                return 0
        stats = collect(pathlib.Path(payload.get("cwd") or ".").resolve())
        if stats:
            print(json.dumps({"systemMessage": summary(stats)}))
        return 0
    stats = collect(pathlib.Path(mode or ".").resolve())
    print(summary(stats) if stats else "No open Refract plans")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv))
    except OSError:
        sys.exit(0)
